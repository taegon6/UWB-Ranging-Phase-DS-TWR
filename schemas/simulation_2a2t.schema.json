{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwb.local/schemas/simulation_2a2t.schema.json",
  "title": "Paper-grounded direct-2A2T timing simulation configuration",
  "type": "object",
  "required": [
    "schema_version",
    "config_kind",
    "source_type",
    "hardware_verified",
    "model_basis"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "config_kind": {
      "enum": ["simulation_2a2t_baseline", "simulation_2a2t_sweep"]
    },
    "source_type": {"const": "SYNTHETIC"},
    "hardware_verified": {"const": false},
    "model_basis": {"const": "PAPER_GROUNDED"},
    "sources": {"type": "object"},
    "paper_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/airtimeProfile"}
    },
    "code_baseline_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/airtimeProfile"}
    },
    "baseline_config": {"type": "string", "minLength": 1},
    "protocol": {"$ref": "#/$defs/protocol"},
    "sweep": {"$ref": "#/$defs/sweep"},
    "outputs": {"type": "object"},
    "phase_gate": {
      "type": "object",
      "properties": {
        "implemented_through": {"const": 4},
        "phase_5_enabled": {"const": false},
        "phase_6_enabled": {"const": false}
      },
      "required": ["implemented_through", "phase_5_enabled", "phase_6_enabled"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"config_kind": {"const": "simulation_2a2t_baseline"}}},
      "then": {"required": ["sources", "paper_profiles", "code_baseline_profiles"]}
    },
    {
      "if": {"properties": {"config_kind": {"const": "simulation_2a2t_sweep"}}},
      "then": {"required": ["baseline_config", "protocol", "sweep", "outputs", "phase_gate"]}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["value", "unit", "evidence_class", "source", "locator", "hardware_verified"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "evidence_class": {
          "enum": ["PAPER", "PAPER_DERIVED", "CODE_BASELINE", "ASSUMED", "SWEEP", "MEASURED"]
        },
        "source": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "hardware_verified": {"const": false},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "required": ["psdu_octets"],
      "properties": {
        "psdu_octets": {"$ref": "#/$defs/parameter"}
      },
      "additionalProperties": false
    },
    "phy": {
      "type": "object",
      "required": [
        "preamble_symbols",
        "sfd_symbols",
        "preamble_symbol_time_us",
        "phr_time_us",
        "coded_bit_time_us",
        "rs_parity_bits",
        "sts_symbols"
      ],
      "properties": {
        "preamble_symbols": {"$ref": "#/$defs/parameter"},
        "sfd_symbols": {"$ref": "#/$defs/parameter"},
        "preamble_symbol_time_us": {"$ref": "#/$defs/parameter"},
        "phr_time_us": {"$ref": "#/$defs/parameter"},
        "coded_bit_time_us": {"$ref": "#/$defs/parameter"},
        "rs_parity_bits": {"$ref": "#/$defs/parameter"},
        "sts_symbols": {"$ref": "#/$defs/parameter"}
      },
      "additionalProperties": false
    },
    "airtimeProfile": {
      "type": "object",
      "required": ["profile_type", "phy", "packets"],
      "properties": {
        "profile_type": {"enum": ["PAPER", "CODE_BASELINE"]},
        "phy": {"$ref": "#/$defs/phy"},
        "packets": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"$ref": "#/$defs/packet"}
        },
        "timing": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "sender", "receiver"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "sender": {"enum": ["ANCHOR", "TAG"]},
        "receiver": {"enum": ["ANCHOR", "TAG"]}
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["links", "slot_order", "sequence", "transitions"],
      "properties": {
        "links": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["A1-T1", "A2-T1", "A1-T2", "A2-T2"]},
          "minItems": 4,
          "maxItems": 4
        },
        "slot_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["A1-T1", "A2-T1", "A1-T2", "A2-T2"]},
          "minItems": 4,
          "maxItems": 4
        },
        "sequence": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "transitions": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/transition"}
        }
      },
      "additionalProperties": false
    },
    "parameterList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/parameter"}
    },
    "sweep": {
      "type": "object",
      "required": [
        "profile_names",
        "processing_time_us",
        "reply_guard_us",
        "timeout_margin_us",
        "slot_guard_us"
      ],
      "properties": {
        "profile_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "processing_time_us": {"$ref": "#/$defs/parameterList"},
        "reply_guard_us": {"$ref": "#/$defs/parameterList"},
        "timeout_margin_us": {"$ref": "#/$defs/parameterList"},
        "slot_guard_us": {"$ref": "#/$defs/parameterList"}
      },
      "additionalProperties": false
    }
  }
}
